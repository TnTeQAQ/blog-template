# Copy to .env and customize. All values are public (baked into the bundle),
# so never put secrets here.
VITE_SITE_NAME=My Blog
VITE_SITE_SUBTITLE=A minimalist blog template
VITE_SITE_ABOUT=A minimalist blog template. Every component is customizable — cards, buttons, animations and the markdown renderer.

# Optional: serve under a sub-path (e.g. a project page https://user.github.io/repo/).
# Leave empty for a custom domain or https://user.github.io/.
# VITE_BASE=/repo-name/
